{
  "name": "liberusoftware/module-accounting-financial-master-data",
  "description": "Provider-neutral accounting customers, suppliers, items, tax profiles, payment terms, addresses, and bank references.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-accounting-core": "^1.0"
  },
  "autoload": { "psr-4": { "Liberu\\Accounting\\FinancialMasterData\\": "src/" } },
  "autoload-dev": { "psr-4": { "Liberu\\Accounting\\FinancialMasterData\\Tests\\": "tests/" } },
  "extra": { "laravel": { "providers": ["Liberu\\Accounting\\FinancialMasterData\\FinancialMasterDataServiceProvider"] }, "liberu": { "name": "accounting-financial-master-data" } },
  "version": "1.0.0",
  "require-dev": { "liberusoftware/package-testbench": "^1.5", "pestphp/pest": "^5.0" },
  "scripts": { "test": "pest" },
  "config": { "allow-plugins": { "pestphp/pest-plugin": true } }
}
