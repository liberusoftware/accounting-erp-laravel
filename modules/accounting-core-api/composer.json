{
    "name": "liberusoftware/module-accounting-core-api",
    "description": "HTTP API adapter for Liberu Accounting Core.",
    "type": "liberu-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/http": "^13.38.0",
        "illuminate/routing": "^13.38.0",
        "laravel/framework": "^13.38.0",
        "liberusoftware/module-accounting-core": "^1.0",
        "laravel/sanctum": "^4.3.3"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Accounting\\CoreApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Accounting\\CoreApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Liberu\\Accounting\\CoreApi\\AccountingCoreApiServiceProvider"
            ]
        },
        "liberu": {
            "name": "accounting-core-api"
        }
    },
    "version": "1.0.0",
    "require-dev": {
        "liberusoftware/package-testbench": "^1.5",
        "pestphp/pest": "^5.3.3"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
