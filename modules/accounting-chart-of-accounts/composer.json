{
  "name": "liberusoftware/module-accounting-chart-of-accounts",
  "description": "Provider-neutral chart of accounts, hierarchy, controls, templates, and lifecycle rules.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/module-accounting-core": "^1.0"
  },
  "autoload": { "psr-4": { "Liberu\\Accounting\\ChartOfAccounts\\": "src/" } },
  "autoload-dev": { "psr-4": { "Liberu\\Accounting\\ChartOfAccounts\\Tests\\": "tests/" } },
  "extra": {
    "laravel": { "providers": ["Liberu\\Accounting\\ChartOfAccounts\\ChartOfAccountsServiceProvider"] },
    "liberu": { "name": "accounting-chart-of-accounts" }
  },
  "version": "1.0.0",
  "require-dev": { "liberusoftware/package-testbench": "^1.5", "pestphp/pest": "^5.0" },
  "scripts": { "test": "pest" },
  "config": { "allow-plugins": { "pestphp/pest-plugin": true } }
}
