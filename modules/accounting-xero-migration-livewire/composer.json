{
    "name": "liberusoftware/module-accounting-xero-migration-livewire",
    "description": "Livewire adapter for Accounting Xero Migration.",
    "type": "liberu-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "livewire/livewire": "^4.0",
        "liberusoftware/module-accounting-xero-migration": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Accounting\\XeroMigrationLivewire\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Liberu\\Accounting\\XeroMigrationLivewire\\XeroMigrationLivewireServiceProvider"
            ]
        },
        "liberu": {
            "name": "accounting-xero-migration-livewire"
        }
    },
    "version": "1.0.0",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
