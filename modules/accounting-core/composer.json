{
  "name": "liberusoftware/module-accounting-core",
  "description": "Provider-neutral legal entities, books, currencies, fiscal calendars, numbering, defaults, policies, and events.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.38.0",
    "illuminate/support": "^13.38.0",
    "liberusoftware/module-manager": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Accounting\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Accounting\\Core\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Liberu\\Accounting\\Core\\AccountingCoreServiceProvider"]
    },
    "liberu": {
      "name": "accounting-core"
    }
  },
  "version": "1.0.0",
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.3.3"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
