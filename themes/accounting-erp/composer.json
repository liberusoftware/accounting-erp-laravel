{
  "name": "liberusoftware/theme-accounting-erp",
  "description": "Accounting ERP public theme with free and SaaS Premium landing experiences.",
  "type": "liberu-theme",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "liberusoftware/theme-support": "^1.0",
    "liberusoftware/theme-base": "^2.0"
  },
  "autoload": {
    "psr-4": {"Liberu\\Themes\\AccountingErp\\": "src/"}
  },
  "extra": {"liberu": {"name": "accounting-erp"}},
  "version": "1.0.0",
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "autoload-dev": {
    "psr-4": {"Liberu\\Themes\\AccountingErp\\Tests\\": "tests/"}
  },
  "scripts": {"test": "pest"},
  "config": {"allow-plugins": {"pestphp/pest-plugin": true}}
}
